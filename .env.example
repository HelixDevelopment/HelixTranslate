# ---------------------------------------------------------------------------
# HelixTranslate — environment template (tracked example; copy to .env)
# Real secrets live ONLY in .env (git-ignored per §11.4.30 / §11.4.10).
# ---------------------------------------------------------------------------

# §11.4 release-tag prefix mandate (HelixConstitution):
#   Every release tag / version name on the main repo AND every owned submodule
#   is prefixed with the project release prefix, form: <PREFIX>-<version>
#   e.g. helix_translate-1.0.0-dev-0.0.1
#
# Resolution order used by scripts/release/resolve_release_prefix.sh:
#   1. HELIX_RELEASE_PREFIX from this .env (authoritative when set)
#   2. fallback: lowercase snake_case of the project root directory name
HELIX_RELEASE_PREFIX=helix_translate

# --- LLM provider API keys (never commit real values) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=

# --- SSH distributed worker ---
SSH_WORKER_HOST=
SSH_WORKER_USER=
SSH_WORKER_PASSWORD=
SSH_WORKER_PORT=22
SSH_WORKER_REMOTE_DIR=

# --- server / logging ---
MONITOR_SERVER_PORT=8090
LOG_LEVEL=info
