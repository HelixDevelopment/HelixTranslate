# .env.nezha.example — template for the nezha full-stack deployment.
#
# Copy to .env.nezha (gitignored — NEVER commit the real file) and fill in real
# values. Consumed by compose.nezha.yml via `env_file: ./.env.nezha`.
# Every value below is a placeholder; no real secret is tracked in git (§11.4.10).
#
#   cp .env.nezha.example .env.nezha   # then edit .env.nezha with real secrets

# ---- PostgreSQL ----
POSTGRES_USER=translator
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=translator

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- API / auth ----
JWT_SECRET=CHANGE_ME_jwt_secret
LOG_LEVEL=info

# ---- LLM provider API keys (set the ones you use; leave others blank) ----
# Keys enumerated from the codebase provider layer (pkg/translator/llm + internal).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NOVITA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
SILICONFLOW_API_KEY=
NVIDIA_API_KEY=
REPLICATE_API_KEY=
UPSTAGE_API_KEY=
KIMI_API_KEY=
MODAL_API_KEY=
NLP_CLOUD_API_KEY=
CLOUDFLARE_API_KEY=
SARVAM_API_KEY=
PUBLICAI_API_KEY=
VULAVULA_API_KEY=
NIA_API_KEY=

# ---- LLMsVerifier (model verification gate) ----
LLMSVERIFIER_API_KEY=

# ---- SSH worker (distributed mode; scrubbed config.distributed*.json reads this) ----
SSH_WORKER_PASSWORD=

# ---- containers submodule remote host (Phase B: pkg/remote orchestrator) ----
# nezha is a pure container HOST — it is NOT added to config.json distributed.workers.
CONTAINERS_REMOTE_HOST_1_NAME=nezha
CONTAINERS_REMOTE_HOST_1_ADDRESS=nezha.local
CONTAINERS_REMOTE_HOST_1_USER=milosvasic
CONTAINERS_REMOTE_HOST_1_RUNTIME=podman
