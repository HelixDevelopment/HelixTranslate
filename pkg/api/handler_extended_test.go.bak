package api

import (
	"bytes"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"

	"digital.vasic.translator/internal/config"
	"digital.vasic.translator/pkg/events"
	"digital.vasic.translator/pkg/websocket"

	"github.com/gin-gonic/gin"
	"github.com/stretchr/testify/assert"
)

// TestTranslateTextExtended tests the translateText handler with more cases
func TestTranslateTextExtended(t *testing.T) {
	// Set Gin to test mode
	gin.SetMode(gin.TestMode)
	
	// Create a test handler with mock dependencies
	cfg := &config.Config{}
	eventBus := events.NewEventBus()
	wsHub := websocket.NewHub(eventBus)
	
	handler := &Handler{
		config:             cfg,
		eventBus:           eventBus,
		wsHub:              wsHub,
		distributedManager: nil,
	}
	
	t.Run("translateText with missing fields", func(t *testing.T) {
		router := gin.New()
		router.POST("/translate", handler.translateText)
		
		// Test with missing target_lang
		testData := map[string]interface{}{
			"text":        "Hello world",
			"source_lang": "en",
		}
		
		jsonData, _ := json.Marshal(testData)
		req, _ := http.NewRequest("POST", "/translate", bytes.NewBuffer(jsonData))
		req.Header.Set("Content-Type", "application/json")
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should fail with missing fields
		assert.Equal(t, http.StatusBadRequest, w.Code)
		
		// Just check the response body for now
		body := w.Body.String()
		t.Logf("Response body: %s", body)
		
		var response map[string]interface{}
		err := json.Unmarshal(w.Body.Bytes(), &response)
		if err == nil && response["status"] != nil {
			assert.Equal(t, float64(400), response["status"])
		}
	})
	
	t.Run("translateText with empty text", func(t *testing.T) {
		router := gin.New()
		router.POST("/translate", handler.translateText)
		
		testData := map[string]interface{}{
			"text":        "",
			"source_lang": "en",
			"target_lang": "es",
		}
		
		jsonData, _ := json.Marshal(testData)
		req, _ := http.NewRequest("POST", "/translate", bytes.NewBuffer(jsonData))
		req.Header.Set("Content-Type", "application/json")
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should fail with empty text
		assert.Equal(t, http.StatusBadRequest, w.Code)
		
		// Just check the response for now
		body := w.Body.String()
		t.Logf("Response body: %s", body)
	})
}

// TestTranslateFB2Extended tests the translateFB2 handler with more cases
func TestTranslateFB2Extended(t *testing.T) {
	// Set Gin to test mode
	gin.SetMode(gin.TestMode)
	
	// Create a test handler with mock dependencies
	cfg := &config.Config{}
	eventBus := events.NewEventBus()
	wsHub := websocket.NewHub(eventBus)
	
	handler := &Handler{
		config:             cfg,
		eventBus:           eventBus,
		wsHub:              wsHub,
		distributedManager: nil,
	}
	
	t.Run("translateFB2 with missing headers", func(t *testing.T) {
		router := gin.New()
		router.POST("/translate/fb2", handler.translateFB2)
		
		fb2Content := `<?xml version="1.0" encoding="UTF-8"?>
<FictionBook xmlns="http://www.gribuser.ru/xml/fictionbook/2.0">
	<description>
		<title-info>
			<genre>nonfiction</genre>
			<book-title>Test Book</book-title>
		</title-info>
	</description>
	<body>
		<section>
			<p>Test content</p>
		</section>
	</body>
</FictionBook>`
		
		formData := bytes.NewBufferString(fb2Content)
		
		req, _ := http.NewRequest("POST", "/translate/fb2", formData)
		req.Header.Set("Content-Type", "application/xml")
		// Missing language headers
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should fail with missing headers
		assert.Equal(t, http.StatusBadRequest, w.Code)
		
		var response map[string]interface{}
		err := json.Unmarshal(w.Body.Bytes(), &response)
		assert.NoError(t, err)
		assert.Equal(t, float64(400), response["status"])
		assert.Contains(t, response["error"], "language")
	})
}

// TestDiscoverWorkersExtended tests the discoverWorkers handler with more cases
func TestDiscoverWorkersExtended(t *testing.T) {
	// Set Gin to test mode
	gin.SetMode(gin.TestMode)
	
	// Create a test handler with mock dependencies
	cfg := &config.Config{}
	eventBus := events.NewEventBus()
	wsHub := websocket.NewHub(eventBus)
	
	handler := &Handler{
		config:             cfg,
		eventBus:           eventBus,
		wsHub:              wsHub,
		distributedManager: nil,
	}
	
	t.Run("discoverWorkers with invalid network range", func(t *testing.T) {
		router := gin.New()
		router.POST("/api/v1/distributed/workers/discover", handler.discoverWorkers)
		
		testData := map[string]interface{}{
			"network_range": "invalid-range",
		}
		
		jsonData, _ := json.Marshal(testData)
		req, _ := http.NewRequest("POST", "/api/v1/distributed/workers/discover", bytes.NewBuffer(jsonData))
		req.Header.Set("Content-Type", "application/json")
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should return 503 when distributedManager is nil
		assert.Equal(t, http.StatusServiceUnavailable, w.Code)
	})
	
	t.Run("discoverWorkers with valid network range", func(t *testing.T) {
		router := gin.New()
		router.POST("/api/v1/distributed/workers/discover", handler.discoverWorkers)
		
		testData := map[string]interface{}{
			"network_range": "192.168.1.0/24",
		}
		
		jsonData, _ := json.Marshal(testData)
		req, _ := http.NewRequest("POST", "/api/v1/distributed/workers/discover", bytes.NewBuffer(jsonData))
		req.Header.Set("Content-Type", "application/json")
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should return 503 when distributedManager is nil
		assert.Equal(t, http.StatusServiceUnavailable, w.Code)
	})
}

// TestAuthMiddlewareExtended tests the authMiddleware with more cases
func TestAuthMiddlewareExtended(t *testing.T) {
	// Set Gin to test mode
	gin.SetMode(gin.TestMode)
	
	// Create a test handler with mock dependencies
	cfg := &config.Config{}
	eventBus := events.NewEventBus()
	wsHub := websocket.NewHub(eventBus)
	
	handler := &Handler{
		config:             cfg,
		eventBus:           eventBus,
		wsHub:              wsHub,
		distributedManager: nil,
		authService:        nil, // No auth service for testing
	}
	
	t.Run("authMiddleware with missing token", func(t *testing.T) {
		router := gin.New()
		router.Use(handler.authMiddleware())
		router.GET("/protected", func(c *gin.Context) {
			c.JSON(http.StatusOK, gin.H{"message": "protected"})
		})
		
		req, _ := http.NewRequest("GET", "/protected", nil)
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should return 401 when no token is provided
		assert.Equal(t, http.StatusUnauthorized, w.Code)
		
		var response map[string]interface{}
		err := json.Unmarshal(w.Body.Bytes(), &response)
		assert.NoError(t, err)
		assert.Equal(t, float64(401), response["status"])
	})
	
	t.Run("authMiddleware with invalid token", func(t *testing.T) {
		router := gin.New()
		router.Use(handler.authMiddleware())
		router.GET("/protected", func(c *gin.Context) {
			c.JSON(http.StatusOK, gin.H{"message": "protected"})
		})
		
		req, _ := http.NewRequest("GET", "/protected", nil)
		req.Header.Set("Authorization", "Bearer invalid-token")
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should return 401 when invalid token is provided
		assert.Equal(t, http.StatusUnauthorized, w.Code)
	})
}

// TestLoginExtended tests the login handler with more cases
func TestLoginExtended(t *testing.T) {
	// Set Gin to test mode
	gin.SetMode(gin.TestMode)
	
	// Create a test handler with mock dependencies
	cfg := &config.Config{}
	eventBus := events.NewEventBus()
	wsHub := websocket.NewHub(eventBus)
	
	handler := &Handler{
		config:             cfg,
		eventBus:           eventBus,
		wsHub:              wsHub,
		distributedManager: nil,
		authService:        nil, // No auth service for testing
	}
	
	t.Run("login with missing credentials", func(t *testing.T) {
		router := gin.New()
		router.POST("/login", handler.login)
		
		testData := map[string]interface{}{
			"username": "testuser",
			// Missing password
		}
		
		jsonData, _ := json.Marshal(testData)
		req, _ := http.NewRequest("POST", "/login", bytes.NewBuffer(jsonData))
		req.Header.Set("Content-Type", "application/json")
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should return 400 when credentials are missing
		assert.Equal(t, http.StatusBadRequest, w.Code)
		
		var response map[string]interface{}
		err := json.Unmarshal(w.Body.Bytes(), &response)
		assert.NoError(t, err)
		assert.Equal(t, float64(400), response["status"])
		assert.Contains(t, response["error"], "required")
	})
	
	t.Run("login with empty credentials", func(t *testing.T) {
		router := gin.New()
		router.POST("/login", handler.login)
		
		testData := map[string]interface{}{
			"username": "",
			"password": "",
		}
		
		jsonData, _ := json.Marshal(testData)
		req, _ := http.NewRequest("POST", "/login", bytes.NewBuffer(jsonData))
		req.Header.Set("Content-Type", "application/json")
		w := httptest.NewRecorder()
		router.ServeHTTP(w, req)
		
		// Should return 400 when credentials are empty
		assert.Equal(t, http.StatusBadRequest, w.Code)
		
		var response map[string]interface{}
		err := json.Unmarshal(w.Body.Bytes(), &response)
		assert.NoError(t, err)
		assert.Equal(t, float64(400), response["status"])
		assert.Contains(t, response["error"], "required")
	})
}